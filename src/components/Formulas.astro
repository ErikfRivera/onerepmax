---
import { FORMULAS_COPY, EXAMPLE_SET } from '../data/content';
import { formulaRows } from '../lib/markdown';
const { weight: w, reps: r } = EXAMPLE_SET;
const { rows, avg } = formulaRows();
const C = FORMULAS_COPY;
---
<section class="below formulas" id="formulas" aria-labelledby="m-head">
  <h2 id="m-head">{C.heading}</h2>
  <p class="intro">{C.intro}</p>
  <div class="fcards">
    <div class="fcard"><b>{C.epley.name}</b><span class="eq">{C.epley.eq}</span><p>{C.epley.note}</p></div>
    <div class="fcard"><b>{C.brzycki.name}</b><span class="eq">{C.brzycki.eq}</span><p>{C.brzycki.note}</p></div>
  </div>
  <p class="body">{C.comparison(w, r)}</p>
  <div class="table-wrap">
    <table class="ftable">
      <thead><tr><th>Formula</th><th>Equation</th><th>{w} × {r}</th></tr></thead>
      <tbody>
        {rows.map((f) => (
          <tr class={f.used ? 'used' : undefined}>
            <td><b>{f.name}</b><small>{f.year}{f.used ? ', in our average' : ''}</small><small class="eq-m">{f.eq}</small></td>
            <td class="eqc">{f.eq}</td>
            <td class="num">{f.value}</td>
          </tr>
        ))}
        <tr class="avg"><td><b>Our estimate</b><small>Epley and Brzycki average</small></td><td class="eqc"></td><td class="num">{avg}</td></tr>
      </tbody>
    </table>
  </div>
  <h3 class="sub-h">{C.rirHeading}</h3>
  <p class="body">{C.rir}</p>
  <h3 class="sub-h">{C.limitsHeading}</h3>
  <p class="body">{C.limits}</p>
</section>
