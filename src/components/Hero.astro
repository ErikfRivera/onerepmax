---
import Laurel from './Laurel.astro';
import { SITE } from '../data/site';
---
<div class="logo"><span>[LOGO]</span></div>
<div class="hero">
  <div class="proof">
    <Laurel />
    <span class="faces" aria-hidden="true"><i style="background:#D6D0C4"></i><i style="background:#B8B0A1"></i><i style="background:#8F887B"></i></span>
    <span>Maxes taken by <b>{SITE.usersCount}</b> lifters and coaches</span>
    <Laurel flip />
  </div>
  <h1>One-Rep Max Calculator</h1>
  <p class="lede">Find your <b>one-rep max</b>. See how you compare.</p>
  <p class="credit">
    Uses the two formulas strength coaches rely on most, developed by <b>Boyd Epley</b> (founder of the NSCA)
    and <b>Matt Brzycki</b> (Princeton strength coach).
  </p>
</div>
