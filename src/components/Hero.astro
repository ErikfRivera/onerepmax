---
import Laurel from './Laurel.astro';
import { SITE } from '../data/site';
---
<div class="logo"><span>[LOGO]</span></div>
<div class="hero">
  <div class="proof">
    <Laurel />
    <span class="faces" aria-hidden="true">
      {/* AI-generated (Higgsfield Soul 2.0) portraits, not actual users. Swap for consented user photos when available. */}
      <img src="/faces/lifter-1.webp" alt="" width="20" height="20" decoding="async" />
      <img src="/faces/lifter-2.webp" alt="" width="20" height="20" decoding="async" />
      <img src="/faces/lifter-3.webp" alt="" width="20" height="20" decoding="async" />
    </span>
    <span>Maxes taken by <b>{SITE.usersCount}</b> lifters and coaches</span>
    <Laurel flip />
  </div>
  <h1>One-Rep Max Calculator</h1>
  <p class="lede">Find your <b>one-rep max</b>. See how you compare.</p>
  <p class="credit">
    Uses the two formulas strength coaches rely on most, developed by <b>Boyd Epley</b> (founder of the NSCA)
    and <b>Matt Brzycki</b> (Princeton strength coach).
  </p>
</div>
