---
import { LIFTS } from '../data/flow';
---
<div class="lift-picker">
  <div class="q-row"><h2>Which lift did you do?</h2><span>1/5</span></div>
  <div class="meter" role="presentation"><i></i></div>
  <div class="lift-grid">
    {LIFTS.map((l, i) => (
      <button type="button" class="tile lift" data-lift={l.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        <strong>{l.id}</strong><small>{l.sub}</small>
        <span class="check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      </button>
    ))}
  </div>
  <div class="picker-foot">
    <button type="button" class="pill" data-act="start"><span class="point" aria-hidden="true">👉</span>Continue</button>
  </div>
  <noscript><p class="hint">The calculator needs JavaScript. The formulas and FAQ below work without it.</p></noscript>
</div>
<ul class="assure" aria-label="Free to use, no account needed">
  <li><svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M5 8.3l2 2 4-4.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>100% Free</li>
  <li><svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M5 8.3l2 2 4-4.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>No Signup Required</li>
</ul>
